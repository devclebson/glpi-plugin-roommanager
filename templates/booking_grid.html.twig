<div class="roommanager-wrapper">
    
    {# Cabeçalho com Seletor de Data #}
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h2 class="m-0"><i class="ti ti-calendar"></i> Reservas para {{ date|date('d/m/Y') }}</h2>
            <form method="GET" class="d-flex gap-2">
                <input type="date" name="date" class="form-control" value="{{ date }}">
                <button type="submit" class="btn btn-primary">Buscar</button>
            </form>
        </div>
    </div>

    {# A Grade de Horários #}
    <div class="table-responsive card p-2">
        <table class="table table-bordered table-hover room-grid">
            <thead>
                <tr>
                    <th class="room-col">Sala / Horário</th>
                    {% for slot in slots %}
                        <th class="text-center slot-header">
                            {{ slot.name }}<br>
                            <small class="text-muted">{{ slot.start_time|slice(0,5) }} - {{ slot.end_time|slice(0,5) }}</small>
                        </th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for room in rooms %}
                    <tr>
                        <td class="fw-bold align-middle">
                            <i class="ti ti-building"></i> {{ room.name }}
                            <div class="small text-muted">Cap: {{ room.capacity }} pessoas</div>
                        </td>

                        {% for slot in slots %}
                            {# Verifica se existe reserva neste cruzamento (Sala x Slot) #}
                            {% set booking = bookings_map[room.id][slot.id] ?? null %}
                            
                            <td class="text-center align-middle p-1">
                                {% if booking %}
                                    {# BLOCO OCUPADO #}
                                    <div class="booking-slot occupied {% if booking.users_id == user_id %}my-booking{% endif %}">
                                        <div class="fw-bold small">Reservado</div>
                                        <div class="xsmall text-truncate" title="{{ booking.username }}">
                                            {{ booking.username }}
                                        </div>
                                    </div>
                                {% else %}
                                    {# BLOCO LIVRE #}
                                    <button class="btn btn-sm btn-outline-success w-100 btn-book"
                                            data-room-id="{{ room.id }}"
                                            data-slot-id="{{ slot.id }}"
                                            data-room-name="{{ room.name }}"
                                            data-slot-name="{{ slot.name }}">
                                        <i class="ti ti-plus"></i> Reservar
                                    </button>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# Modal de Confirmação (Invisível por padrão) #}
<div class="modal fade" id="modalBooking" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Reserva</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Você deseja reservar a <strong><span id="modalRoomName"></span></strong> para o horário <strong><span id="modalSlotName"></span></strong>?</p>
                <form id="formBooking">
                    <input type="hidden" name="room_id" id="inputRoomId">
                    <input type="hidden" name="slot_id" id="inputSlotId">
                    <input type="hidden" name="date" value="{{ date }}">
                    <input type="hidden" name="action" value="add_booking">
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmBooking">Confirmar</button>
            </div>
        </div>
    </div>
</div>

{# Script JS simples inline para lidar com o Modal #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Configuração do Modal
    var modalEl = document.getElementById('modalBooking');
    var modal = new bootstrap.Modal(modalEl);
    
    // 1. Abrir Modal ao clicar no botão "Reservar"
    document.querySelectorAll('.btn-book').forEach(btn => {
        btn.addEventListener('click', function() {
            // Preenche o modal com os dados do botão clicado
            document.getElementById('modalRoomName').textContent = this.dataset.roomName;
            document.getElementById('modalSlotName').textContent = this.dataset.slotName;
            
            // Preenche os inputs ocultos
            document.getElementById('inputRoomId').value = this.dataset.roomId;
            document.getElementById('inputSlotId').value = this.dataset.slotId;
            
            modal.show();
        });
    });

    // 2. Ação do Botão Confirmar (AJAX)
    document.getElementById('btnConfirmBooking').addEventListener('click', function() {
        const btn = this;
        const originalText = btn.textContent;
        
        // Estado de "Carregando"
        btn.disabled = true;
        btn.textContent = "Salvando...";

        // Prepara os dados do formulário
        const formData = new FormData(document.getElementById('formBooking'));
        
        // URL do arquivo PHP que criamos
        // GLPI_ROOT precisa ser tratado se estiver em subpasta, mas relativo geralmente funciona:
        const url = "../plugins/roommanager/ajax/booking.php"; 

        fetch(url, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Sucesso: Recarrega a página para atualizar a grade
                window.location.reload(); 
            } else {
                // Erro de lógica (ex: já ocupado)
                alert(data.message);
                btn.disabled = false;
                btn.textContent = originalText;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert("Erro de comunicação com o servidor.");
            btn.disabled = false;
            btn.textContent = originalText;
        });
    });
});
</script>